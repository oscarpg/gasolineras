{
  "name": "gasolineras",
  "version": "0.1.0",
  "private": true,
  "description": "Mapa de las gasolineras más cercanas y baratas de España (datos MITECO).",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "fixtures": "node scripts/capture-fixtures.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "leaflet": "^1.9.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/leaflet": "^1.9.0",
    "@vitest/coverage-v8": "^5.1.1",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^10.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^7.0.0",
    "vitest": "^5.1.1"
  }
}
